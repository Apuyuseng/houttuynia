# ============================================================
# 鱼腥草（Houttuynia）NAS 版 —— 多架构自含镜像（Docker Hub 发布用）
#
# 构建上下文（/tmp/hubctx 组装）：
#   mwine-nas-amd64 / mwine-nas-arm64  musl 静态网关（容器内编译）
#   web/                               web-vue/dist
#   bin/scrcpy-server-v4.1             scrcpy server jar
#   bin/mwine-bridge.apk               壁纸/通知桥
#   arch/<amd64|arm64>/adb             官方 platform-tools adb（按架构可选）
#   entrypoint.sh                      入口脚本（nas/entrypoint.hub.sh）
#
# adb：官方 platform-tools 只有 linux-amd64；arm64 无官方静态版（Debian 的
# android-tools-adb 需 glibc>=2.38 + 全套 android 私有库，slim 基座带不动）
# → 按架构目录放入，没有就不装（网关集成传输层兜底）。
#
# ⚠️ 组装上下文后、构建前必须 `xattr -rc /tmp/hubctx`：macOS 的
# com.apple.provenance 等 xattr 一旦进入层 tar，Linux Docker 解层报
# lsetxattr "operation not supported"（DockerHub 发布已踩坑两次）。
# ============================================================

FROM debian:bookworm-slim

ARG TARGETARCH

COPY mwine-nas-${TARGETARCH} /usr/local/bin/mwine-nas
COPY web/ /opt/mwine/web/
COPY bin/ /opt/mwine/bin/
COPY entrypoint.sh /opt/mwine/entrypoint.sh
COPY arch/${TARGETARCH}/ /opt/mwine/arch/

RUN set -eux; \
    chmod +x /opt/mwine/entrypoint.sh /usr/local/bin/mwine-nas /opt/mwine/bin/scrcpy-server-v4.1; \
    if [ -f /opt/mwine/arch/adb ]; then mv /opt/mwine/arch/adb /opt/mwine/adb && chmod +x /opt/mwine/adb; fi; \
    rm -rf /opt/mwine/arch; \
    mkdir -p /data

ENV HOME=/data \
    MWINE_HOST=0.0.0.0 \
    MWINE_TLS_PORT=18443 \
    MWINE_WEB_DIR=/opt/mwine/web \
    PATH=/opt/mwine:$PATH

VOLUME /data
EXPOSE 18443
ENTRYPOINT ["/opt/mwine/entrypoint.sh"]
